# Copy this file to .env and fill it in. .env is gitignored.
#
#   cp .env.example .env
#
# Environment variables override the values in this file.

# Required. A Secret key (server) from the Petify Console → Integration →
# API & SDK. It can register, identify and delete pets in your account.
# Keep it on a server: never put it in an app.
PETIFY_SECRET_KEY=

# Optional. The token the example apps send as `Authorization: Bearer <token>`.
# If empty, the server generates a random one at start and prints it; set it
# here to keep the same token across restarts.
EXAMPLE_SERVER_TOKEN=

# Optional. Address and port to listen on. 0.0.0.0 makes the server reachable
# from a phone on the same network; 127.0.0.1 keeps it on this machine.
HOST=0.0.0.0
PORT=8787

# Optional. Petify Server API base URL.
PETIFY_API_BASE_URL=https://api.petify.petnow.io
