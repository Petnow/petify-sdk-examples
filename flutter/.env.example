# Copy this file to .env and fill it in. .env is git-ignored.
#
#   cp .env.example .env
#   flutter run --release --dart-define-from-file=.env
#
# --dart-define compiles the values into the build: rebuild after editing.

# Required. A Client key (app) from the Petify Console (Integration -> API & SDK
# -> API Key Management). Never put a Secret key (server) in an app.
PETIFY_API_KEY=

# Optional: the example server (server/README.md in the examples repository).
# Unset = camera-only mode: the app captures images and uploads nothing.
# Set = server mode: register and identify through the server, which holds the
# Secret key. Use the URL and token the server prints when it starts.
#EXAMPLE_SERVER_URL=http://192.168.0.10:8787
#EXAMPLE_SERVER_TOKEN=
