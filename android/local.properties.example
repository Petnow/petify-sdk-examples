# Copy to local.properties (git-ignored) and fill in.

# Optional. Gradle finds the Android SDK through ANDROID_HOME; uncomment only if
# that is not set. A wrong path here overrides ANDROID_HOME.
# sdk.dir=/path/to/Android/sdk

petnow.apiKey=YOUR_PETNOW_API_KEY

# Optional: the example server (../server/README.md). Leave both commented out for
# camera-only mode; set both to register and identify pets. The server holds the
# Secret key — the app only sends it the token the server printed at start.
# Plain HTTP is allowed to this URL's host only (see app/build.gradle.kts).
# example.serverUrl=http://192.168.0.10:8787
# example.serverToken=TOKEN_PRINTED_BY_THE_SERVER
