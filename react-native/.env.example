# Copy this file to .env and fill it in. .env is gitignored.
#
#   cp .env.example .env
#
# Metro reads this file when it starts: after changing it, restart Metro
# (npm start -- --reset-cache).

# Required. A **Client key (app)** from the Petify Console (Integration →
# API & SDK → Create New API Key). The SDK uses it as its licence, and the app
# uses it to open a capture session in camera-only mode. Never put a Secret key
# in an app: the Secret key belongs in the example server or your server.
PETIFY_API_KEY=

# Optional: the example server (../server/README.md). Leave both empty for
# camera-only mode. Set both for server mode, which registers and identifies
# pets: the URL the server prints at start (your computer's LAN address, e.g.
# http://192.168.0.10:8787) and the token it uses (EXAMPLE_SERVER_TOKEN there).
EXAMPLE_SERVER_URL=
EXAMPLE_SERVER_TOKEN=
