// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is git-ignored.

// Petnow API key from the Petify Console (My Page → API Key Management).
// Use a key dedicated to apps, not the one your server uses.
PETNOW_API_KEY = YOUR_PETNOW_API_KEY

// Signing: your Apple Developer team ID and a bundle identifier you own.
EXAMPLE_TEAM_ID = YOUR_TEAM_ID
EXAMPLE_BUNDLE_ID = com.example.petify.prewarm
