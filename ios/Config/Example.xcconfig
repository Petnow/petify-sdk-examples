// Shared build settings. Your own values go in Secrets.xcconfig (not committed):
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig

// Defaults, overridden by Secrets.xcconfig when it exists. Without it the app still
// builds, and the home screen says PETNOW_API_KEY is missing.
EXAMPLE_BUNDLE_ID = com.example.petify.prewarm
EXAMPLE_TEAM_ID =
PETNOW_API_KEY =

#include? "Secrets.xcconfig"
