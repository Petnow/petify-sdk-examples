<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Petify Prewarm Example</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ExampleServerHost</key>
	<string>$(EXAMPLE_SERVER_HOST)</string>
	<key>ExampleServerToken</key>
	<string>$(EXAMPLE_SERVER_TOKEN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Server mode talks plain HTTP to the example server on your computer.
		     NSAllowsLocalNetworking allows that for .local and unqualified host names only;
		     every other host still needs HTTPS (unlike NSAllowsArbitraryLoads). Loads to an
		     IP address are not subject to ATS at all: checked on the iOS 26.5 simulator, where
		     http://<LAN IP>:port and http://<name>.local:port load with or without this key
		     and http://example.com is refused with it. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to capture your dog's nose print.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Server mode sends the captured images to the example server on your computer.</string>
	<key>PetnowAPIKey</key>
	<string>$(PETNOW_API_KEY)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
