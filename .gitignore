# Secrets — never commit these
ios/Config/Secrets.xcconfig
android/local.properties
react-native/.env
.env
*.netrc

# CodeArtifact registry configuration (contains your registry URL)
**/xcshareddata/swiftpm/configuration/registries.json
**/.swiftpm/configuration/registries.json

# Generated lockfiles. The npm one records CodeArtifact URLs (account ID, domain,
# region); the others are generated per machine with it. See README "Security notes".
react-native/package-lock.json
react-native/ios/Podfile.lock
ios/PrewarmExample.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Build output and caches
.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
.gradle/
.idea/
*.iml
.kotlin/
captures/
node_modules/
Pods/
vendor/bundle/
*.jsbundle
server/.env
